cmake_minimum_required(VERSION 3.25)
# Run with -DCLI=... -DPREFIX=... -DWORK=... -P ci/test-sdk.cmake.
foreach(variable CLI PREFIX WORK)
  if(NOT DEFINED ${variable})
    message(FATAL_ERROR "${variable} is required")
  endif()
endforeach()
function(run)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE result COMMAND_ECHO STDOUT TIMEOUT 300)
  if(NOT result STREQUAL "0")
    message(FATAL_ERROR "Command failed (${result}): ${ARGV}")
  endif()
endfunction()
file(MAKE_DIRECTORY "${WORK}/path with spaces")
set(project "${WORK}/path with spaces/hello")
run("${CLI}" doctor --prefix "${PREFIX}")
run("${CLI}" new "${project}")
run("${CLI}" build --prefix "${PREFIX}" "${project}")
# Generate an imported message separately and ensure imports drive rebuilds.
file(MAKE_DIRECTORY "${project}/proto/shared/v1")
set(import "${project}/proto/shared/v1/types.proto")
file(WRITE "${import}" "syntax = \"proto3\";\npackage shared.v1;\nmessage Attributes { string nickname = 1; }\n")
file(READ "${project}/proto/greet/v1/greet.proto" proto)
string(REPLACE "package greet.v1;" "package greet.v1;\nimport \"shared/v1/types.proto\";" proto "${proto}")
string(REPLACE "string name = 1;" "string name = 1; shared.v1.Attributes attributes = 2;" proto "${proto}")
file(WRITE "${project}/proto/greet/v1/greet.proto" "${proto}")
file(READ "${project}/CMakeLists.txt" build)
string(REPLACE "SERVICES greet/v1/greet.proto)" "SERVICES greet/v1/greet.proto MESSAGES shared/v1/types.proto)" build "${build}")
file(WRITE "${project}/CMakeLists.txt" "${build}")
run("${CLI}" build --prefix "${PREFIX}" "${project}")
set(generated "${project}/build/greet_proto_generated/greet/v1/greet.pb.cc")
file(TIMESTAMP "${generated}" before "%s")
run("${CMAKE_COMMAND}" -E sleep 2)
file(APPEND "${import}" "message Added { string value = 1; }\n")
run("${CLI}" build --prefix "${PREFIX}" "${project}")
file(TIMESTAMP "${generated}" after "%s")
if(NOT after GREATER before)
  message(FATAL_ERROR "Editing an imported schema did not regenerate the service's messages")
endif()
run("${CLI}" skill install --dir "${WORK}/connect-cpp")
