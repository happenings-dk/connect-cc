# Generate message classes and Connect service bindings into a target.
# SERVICES are schemas declaring RPC services; MESSAGES are message-only schemas.
function(connectcpp_generate)
  cmake_parse_arguments(PARSE_ARGV 0 ARG "" "TARGET;PROTO_ROOT" "SERVICES;MESSAGES;IMPORT_DIRS")
  if(ARG_UNPARSED_ARGUMENTS OR ARG_KEYWORDS_MISSING_VALUES OR NOT ARG_TARGET OR NOT ARG_SERVICES AND NOT ARG_MESSAGES)
    message(FATAL_ERROR "connectcpp_generate requires TARGET and SERVICES and/or MESSAGES")
  endif()
  if(NOT ARG_TARGET MATCHES "^[A-Za-z0-9_.+-]+$")
    message(FATAL_ERROR "Invalid generated target name: ${ARG_TARGET}")
  endif()
  if(NOT ARG_PROTO_ROOT)
    set(ARG_PROTO_ROOT "${CMAKE_CURRENT_SOURCE_DIR}")
  endif()
  get_filename_component(root "${ARG_PROTO_ROOT}" ABSOLUTE)
  set(output "${CMAKE_CURRENT_BINARY_DIR}/${ARG_TARGET}_generated")
  file(MAKE_DIRECTORY "${output}")
  set(imports "--proto_path=${root}")
  if(connectcpp_PROTOBUF_LITE)
    get_target_property(protobuf_includes protobuf::libprotobuf-lite INTERFACE_INCLUDE_DIRECTORIES)
  else()
    get_target_property(protobuf_includes protobuf::libprotobuf INTERFACE_INCLUDE_DIRECTORIES)
  endif()
  foreach(directory IN LISTS ARG_IMPORT_DIRS)
    get_filename_component(directory "${directory}" ABSOLUTE)
    if(NOT IS_DIRECTORY "${directory}")
      message(FATAL_ERROR "Proto import directory does not exist: ${directory}")
    endif()
    list(APPEND imports "--proto_path=${directory}")
  endforeach()
  foreach(directory IN LISTS protobuf_includes)
    if(IS_DIRECTORY "${directory}")
      list(APPEND imports "--proto_path=${directory}")
    endif()
  endforeach()
  if(ARG_SERVICES)
    find_program(CONNECTCPP_PROTOC_GEN NAMES protoc-gen-connect-cpp
      HINTS "${_CONNECTCPP_TOOL_DIR}" REQUIRED)
  endif()
  set(schemas ${ARG_SERVICES} ${ARG_MESSAGES})
  list(REMOVE_DUPLICATES schemas)
  set(sources)
  set(cpp_output "${output}")
  if(connectcpp_PROTOBUF_LITE)
    set(cpp_output "lite:${output}")
  endif()
  foreach(schema IN LISTS schemas)
    if(IS_ABSOLUTE "${schema}" OR schema MATCHES "(^|/)\\.\\.(/|$)" OR NOT schema MATCHES "^[A-Za-z0-9_/.-]+\\.proto$")
      message(FATAL_ERROR "Schema paths must be relative .proto paths within PROTO_ROOT: ${schema}")
    endif()
    string(REGEX REPLACE "\\.proto$" "" stem "${schema}")
    set(files "${output}/${stem}.pb.cc" "${output}/${stem}.pb.h")
    set(plugin_args)
    set(plugin_dep)
    if(schema IN_LIST ARG_SERVICES)
      list(APPEND files "${output}/${stem}.connect.cc" "${output}/${stem}.connect.h")
      set(plugin_args "--connect-cpp_out=${output}" "--plugin=protoc-gen-connect-cpp=${CONNECTCPP_PROTOC_GEN}")
      set(plugin_dep "${CONNECTCPP_PROTOC_GEN}")
    endif()
    get_filename_component(parent "${output}/${stem}" DIRECTORY)
    file(MAKE_DIRECTORY "${parent}")
    add_custom_command(OUTPUT ${files}
      COMMAND protobuf::protoc ${imports} "--cpp_out=${cpp_output}" ${plugin_args}
        "--dependency_out=${output}/${stem}.d" "${root}/${schema}"
      DEPENDS "${root}/${schema}" protobuf::protoc ${plugin_dep}
      DEPFILE "${output}/${stem}.d"
      VERBATIM)
    list(APPEND sources ${files})
  endforeach()
  add_library(${ARG_TARGET} STATIC ${sources})
  target_include_directories(${ARG_TARGET} PUBLIC "${output}")
  target_link_libraries(${ARG_TARGET} PUBLIC connectcpp::connectcpp)
endfunction()
